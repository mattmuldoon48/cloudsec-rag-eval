# Copy this file to .env and fill in the key for commands that call OpenAI.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GENERATION_MODEL=gpt-4.1-mini

# Optional alternate corpus; prepare its source files and matching manifest first.
# See README: "Ingest an alternate corpus". These paths are not experiment JSON keys.
# RAW_DOCS_DIR=data/custom_corpus/raw_docs
# DOC_MANIFEST_PATH=data/custom_corpus/doc_manifest.json
# PROCESSED_DIR=data/custom_corpus/processed
